# Anthropic API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# LangSmith Configuration (for tracing)
LANGSMITH_PROJECT=test-langgraph
LANGSMITH_API_KEY=

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# MCP Configuration path (default: ~/.knowledgexpert/conf/mcp/config.json)
MCP_CONFIG_PATH=

# Insurance documents root directory (default: ~/git/knowledgexpert/data/linux-exec/insurance-docs)
INSURANCE_DOCS_ROOT=

# LLM Model
LLM_MODEL=

# Prompts directory (default: .)
PROMPTS_DIR=.

# Checkpoint database path (default: ./.db.sqlite3)
CHECKPOINT_DB_PATH=./.db.sqlite3

# ============================================================================
# Dapr Configuration (for carqna_dapr.py HTTP service)
# ============================================================================

# Port the CarQnA service listens on (for HTTP endpoints)
DAPR_SERVICE_PORT=5001

# Dapr runtime port (for service-to-service communication via sidecar)
DAPR_RUNTIME_PORT=3500

# Service name for Dapr registration
DAPR_SERVICE_NAME=carqna-dapr

# Optional: Dapr state store name (for distributed persistence)
DAPR_STATE_STORE=statestore
