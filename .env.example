# Anthropic API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# LangSmith Configuration (for tracing)
LANGSMITH_PROJECT=carqna-agent
LANGSMITH_API_KEY=

# OpenTelemetry tracing -- exports the same LangChain/LangGraph traces to a
# local Jaeger instance (docker-compose's `jaeger` service), viewable at
# http://localhost:16686. LANGSMITH_TRACING_MODE=hybrid sends traces to both
# LangSmith cloud and Jaeger; use `otel` instead to send to Jaeger only.
# Must be Jaeger's HTTP OTLP port (4318) with the full /v1/traces path --
# langsmith's OTel exporter is hardcoded to HTTP (not gRPC/4317), and passes
# this value straight through to the exporter without appending the path
# itself (unlike the OTel SDK's own env-var handling).
LANGSMITH_TRACING_V2=true
LANGSMITH_TRACING_MODE=hybrid
OTEL_SERVICE_NAME=carqna-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# MCP Configuration path
MCP_CONFIG_PATH=./infrastructure/conf/mcp/config.json

# Insurance documents root directory
INSURANCE_DOCS_ROOT=./data/virtual-fs/insurance-docs

# LLM Model
LLM_MODEL=claude-sonnet-4-5-20250929

# Prompts directory (default: .)
PROMPTS_DIR=.

# Checkpoint database connection string (default: local `convmem` Postgres db,
# see infrastructure/docker/postgres/initdb.d/init_user.sh)
CHECKPOINT_POSTGRES_URI=postgresql://convmem:convmem@localhost:5432/convmem

# Oauth/Okta Auth0 settings -- the agent only verifies incoming tokens
# (resource-server role), it never performs the login/token-exchange flow
# itself, so it needs just these two (no CLIENT_ID/CLIENT_SECRET/SECRET --
# those belong in carqna-copilot-ui/.env.example, the app that actually logs
# users in). AUTH0_AUDIENCE must match the identifier of the API registered
# in the Auth0 dashboard.
AUTH0_DOMAIN=XXXXX
AUTH0_AUDIENCE=https://carqna-agent/api