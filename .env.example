# Anthropic API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# LangSmith Configuration (for tracing)
LANGSMITH_PROJECT=carqna-agent
LANGSMITH_API_KEY=

# MCP Configuration path
MCP_CONFIG_PATH=./infrastructure/conf/mcp/config.json

# Insurance documents root directory
INSURANCE_DOCS_ROOT=./data/virtual-fs/insurance-docs

# LLM Model
LLM_MODEL=claude-sonnet-4-5-20250929

# Prompts directory (default: .)
PROMPTS_DIR=.

# Checkpoint database connection string (default: local `convmem` Postgres db,
# see infrastructure/docker/postgres/initdb.d/init_user.sh)
CHECKPOINT_POSTGRES_URI=postgresql://convmem:convmem@localhost:5432/convmem
